# Copy to .env (gitignored) and fill in the credentials you actually use.
#
# The service calls hosted model APIs only: the process never loads a model and
# needs no local inference server.

# ---------------------------------------------------------------- DashScope
# Default provider for BOTH stages (embedding.provider = reranker.provider =
# "dashscope"): text-embedding-v4 (2048 dimensions) and qwen3-rerank.
#
# MEMORYSUM_DASHSCOPE_API_KEY wins; DASHSCOPE_API_KEY is the fallback.
DASHSCOPE_API_KEY=
MEMORYSUM_DASHSCOPE_API_KEY=

# DashScope host (no path). Defaults to https://dashscope.aliyuncs.com.
# Point this at a dedicated MaaS deployment when the account uses one: measured
# 2026-10-20, the public endpoint ignored `dimension: 2048` and returned 1024-d
# vectors, while the dedicated host honoured it. The service refuses a
# dimension mismatch (HTTP 503 model_provider_invalid_embedding) instead of
# silently storing a different embedding space.
# MEMORYSUM_DASHSCOPE_BASE_URL=https://<workspace>.<region>.maas.aliyuncs.com

# ---------------------------------------------------------------- OpenRouter
# Optional alternative provider (OpenAI-compatible /embeddings + /rerank) for
# either stage; set embedding.provider / reranker.provider to "openrouter".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------- service side
# Inbound Bearer tokens: one raw token per line (no "Bearer " prefix), in a
# local, gitignored file.
MEMORYSUM_API_KEYS_FILE=keys.txt

# Runtime data directory (do not commit its contents).
MEMORYSUM_DATA_ROOT=./data
MEMORYSUM_HOST=0.0.0.0
# The API port is fixed in the application: 8001.
# Full request JSON logging (message/query text); keep disabled outside debugging.
MEMORYSUM_DEBUG=false
