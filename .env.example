# OpenRouter (backend model provider: remote reranker, optional remote embeddings)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DashScope embedding API. Used when champion-v1.json pins
# embedding.provider = "dashscope" (default since 2026-10-20:
# text-embedding-v4, 2048 dimensions). The service calls DashScope's NATIVE
# text-embedding path, not the OpenAI-compatible one.
#
# Point this at the dedicated MaaS deployment. Measured 2026-10-20:
# https://dashscope.aliyuncs.com answered a dimension=2048 request with 1024-d
# vectors, while the dedicated host below honoured it. The service refuses a
# dimension mismatch (HTTP 503 model_provider_invalid_embedding) instead of
# silently storing another embedding space.
#
# Dedicated MaaS deployment (honours `dimension`):
MEMORYSUM_DASHSCOPE_BASE_URL=https://llm-5qr9sf5t4nflguf4.cn-beijing.maas.aliyuncs.com
# Public endpoint (not dimension-safe; kept for reference):
# MEMORYSUM_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# MEMORYSUM_DASHSCOPE_API_KEY wins; DASHSCOPE_API_KEY is the fallback.
DASHSCOPE_API_KEY=
MEMORYSUM_DASHSCOPE_API_KEY=

# Local OpenAI-compatible embeddings endpoint (llama.cpp / vLLM / LM Studio).
# Fallback only: used when champion-v1.json pins embedding.provider = "local-openai"
# (e.g. rolling back from DashScope to a local Qwen3-Embedding server).
MEMORYSUM_EMBEDDING_BASE_URL=http://127.0.0.1:7999/v1
# Optional: only needed when the local server was started with an API key.
MEMORYSUM_EMBEDDING_API_KEY=

# Local cross-encoder rerank endpoint (llama.cpp --reranking on 7997, or a plain
# FastAPI rerank service). Used only when champion-v1.json sets
# reranker.provider = "local-openai" together with reranker.enabled = true.
MEMORYSUM_RERANK_BASE_URL=http://127.0.0.1:7997
# Optional: only needed when the local rerank server was started with an API key.
MEMORYSUM_RERANK_API_KEY=

# Bearer API secrets: one raw token per line (omit the "Bearer " prefix)
# stored only in this local, gitignored file
MEMORYSUM_API_KEYS_FILE=keys.txt

# Runtime data directory (do not commit its contents)
MEMORYSUM_DATA_ROOT=./data
MEMORYSUM_HOST=0.0.0.0
# API port is fixed in the application: 8001
# Full request JSON logging (including message/query text); keep disabled outside local debugging
MEMORYSUM_DEBUG=false
